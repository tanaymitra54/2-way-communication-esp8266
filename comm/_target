# shared helpers — sourced by say/read/wait

resolve_target() {
  if [ -n "${COMM_TARGET:-}" ]; then
    printf '%s\n' "$COMM_TARGET"
    return 0
  fi
  local me sess
  me="${TMUX_PANE:?TMUX_PANE not set — are you inside tmux?}"
  sess="$(tmux display-message -p '#{session_name}:#{window_index}')"
  tmux list-panes -t "$sess" -F '#{pane_id}' | grep -v "^${me}$" | head -1
}

me_label() {
  # -t "$TMUX_PANE" is required: without it display-message reports the
  # ACTIVE pane, so the transcript mislabels the sender whenever focus is
  # in the other pane.
  tmux display-message -p -t "${TMUX_PANE}" '#{session_name}:#{window_index}.#{pane_index}'
}

is_busy() {
  # opencode shows a spinner / interrupt hint while a turn is running
  local t="$1"
  tmux capture-pane -p -t "$t" -S -12 2>/dev/null \
    | grep -qE 'esc (to )?interrupt'
}
