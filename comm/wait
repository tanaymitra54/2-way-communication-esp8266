#!/usr/bin/env bash
# comm/wait — block until the neighbour pane finishes the turn it was given.
# usage: ./comm/wait [timeout_seconds]   (default 180)
#
# Two-phase so it does not return during the race between send-keys and the
# neighbour actually starting its turn:
#   1. wait up to 15s for the turn to *start* (busy marker appears)
#   2. wait for it to *end* (busy marker gone, stable for ~2s)
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/_target"

target="$(resolve_target)"
deadline=$(( $(date +%s) + ${1:-180} ))
start_grace=$(( $(date +%s) + 15 ))
saw_busy=0
stable=0

while :; do
  if is_busy "$target"; then
    saw_busy=1
    stable=0
  else
    if [ "$saw_busy" -eq 1 ]; then
      stable=$(( stable + 1 ))
      if [ "$stable" -ge 4 ]; then
        echo "idle"
        exit 0
      fi
    fi
  fi

  now=$(date +%s)
  if [ "$saw_busy" -eq 0 ] && [ "$now" -ge "$start_grace" ]; then
    echo "idle (turn finished before busy marker appeared)"
    exit 0
  fi
  [ "$now" -lt "$deadline" ] || { echo "timeout (still busy)" >&2; exit 1; }
  sleep 0.5
done
